---
import Layout from '../layouts/Layout.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Countist",
    "url": "https://countist.app/contact",
    "description": "Get in touch with the Countist team for support, feature requests, bug reports, or general questions.",
    "mainEntity": {
      "@type": "Organization",
      "name": "Countist",
      "email": "hello@countist.app",
      "url": "https://countist.app"
    }
  }
];
---

<Layout
  title="Contact — Get Subscription Clarity Today — Countist Subscription Tracker"
  description="Questions about Countist? Need help with your account? Found a bug? Email hello@countist.app — we respond within 24 hours on business days."
  canonical="https://countist.app/contact"
  ogImage="https://countist.app/images/og-contact.png"
  jsonLd={jsonLd}
  currentPath="/contact"
>
  <!-- HERO -->
  <section class="section_main-hero background-color-secondary">
    <div class="padding-global padding-section-large">
      <div class="w-layout-blockcontainer container-small fade-in-bottom w-container" style="text-align:center;">
        <div class="badge" style="margin-bottom:1rem;display:inline-flex;"><div class="badge_text"><div>Get In Touch</div></div></div>
        <h1 class="heading-style-h1">What's On Your Mind?</h1>
        <p class="text-size-medium text-color-secondary" style="margin:1.5rem auto 0;max-width:36rem;">
          Have a question about the service? Need help with your account? Found a bug? Have a feature suggestion? We respond to all messages within 24 hours on business days.
        </p>
        <div style="margin-top:2rem;display:flex;flex-direction:column;align-items:center;gap:0.75rem;">
          <a
            href="mailto:hello@countist.app?subject=Question%20about%20Countist"
            data-wf--button--variant="primary"
            class="button w-inline-block"
          >
            <div class="button_text-large"><div>Email us</div></div>
          </a>
          <p class="text-size-small text-color-secondary" style="margin:0;">
            <a href="mailto:hello@countist.app" style="text-decoration:underline;">hello@countist.app</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section_main">
    <div class="padding-global padding-section-large">
      <div class="w-layout-blockcontainer container-small w-container" style="max-width: 32rem;">
        <form id="contact-form" class="form_fields" novalidate>
          <div>
            <div class="form_lable"><div class="form_lable-text">Name</div></div>
            <input class="w-input form_field" type="text" name="name" id="cm-name" placeholder="Your name" required>
          </div>
          <div>
            <div class="form_lable"><div class="form_lable-text">Email</div></div>
            <input class="w-input form_field" type="email" name="email" id="cm-email" placeholder="you@example.com" required>
          </div>
          <div>
            <div class="form_lable"><div class="form_lable-text">Message</div></div>
            <textarea class="w-input form_field" name="message" id="cm-message" placeholder="What's on your mind?" rows="5" required style="height:auto;resize:vertical;"></textarea>
          </div>
          <button type="submit" class="form_button" id="cm-submit">
            <span id="cm-btn-text">Send message</span>
            <span id="cm-btn-loading" style="display:none;">Sending&hellip;</span>
          </button>
          <div class="form_message-error" id="cm-form-error" style="display:none;"></div>
        </form>
        <div class="form_message-success" id="cm-form-success" style="display:none;">
          Message received — we'll get back to you within 24 hours on business days.
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('cm-submit');
    const btnText = document.getElementById('cm-btn-text');
    const btnLoading = document.getElementById('cm-btn-loading');
    const formError = document.getElementById('cm-form-error');
    const formSuccess = document.getElementById('cm-form-success');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('cm-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('cm-email') as HTMLInputElement).value.trim();
      const message = (document.getElementById('cm-message') as HTMLTextAreaElement).value.trim();

      if (formError) formError.style.display = 'none';
      if (!name || !email || !message) {
        if (formError) { formError.textContent = 'Please fill in your name, email, and message.'; formError.style.display = 'block'; }
        return;
      }

      (submitBtn as HTMLButtonElement).disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoading) btnLoading.style.display = 'inline';

      try {
        const res = await fetch('https://structurl-intake-production.up.railway.app/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            message,
            product: 'Countist',
            type: 'Contact',
            marketingOptIn: false,
            sourceUrl: window.location.href,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          (form as HTMLFormElement).style.display = 'none';
          if (formSuccess) formSuccess.style.display = 'block';
        } else {
          throw new Error(data.error || 'Something went wrong. Please email hello@countist.app directly.');
        }
      } catch (err) {
        if (formError) {
          formError.textContent = err instanceof Error ? err.message : 'Something went wrong.';
          formError.style.display = 'block';
        }
        (submitBtn as HTMLButtonElement).disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnLoading) btnLoading.style.display = 'none';
      }
    });
  </script>
</Layout>
