---
import Layout from '../layouts/Layout.astro';
import policyBody from '../content/privacy-body.html?raw';
---

<Layout
  title="Privacy Policy — Countist Subscription Tracker"
  description="Countist privacy policy: what data we collect, how we use it, and your rights. We never sell your data or connect to your bank."
  canonical="https://countist.app/privacy"
  currentPath="/privacy"
>
  <section class="section_main-hero background-color-secondary">
    <div class="padding-global padding-section-large">
      <div class="w-layout-blockcontainer container-small w-container">
        <div class="fade-in-bottom" style="text-align:center;">
          <div style="margin-bottom:1.25rem;text-align:center;"><div class="badge" style="display:inline-flex;width:auto;"><div class="badge_text"><div>Legal</div></div></div></div>
          <h1 class="heading-style-h1">Privacy Policy</h1>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="padding-global padding-section-large">
      <div class="w-layout-blockcontainer container-small w-container">
        <div class="policy" set:html={policyBody} />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
.policy{max-width:46rem;margin:0 auto;padding:2rem 1.25rem 4rem;line-height:1.65}
.policy h2{margin:2.25rem 0 .6rem;font-size:1.35rem;line-height:1.3}
.policy h3{margin:1.5rem 0 .4rem;font-size:1.05rem}
.policy p,.policy li{margin:.6rem 0}
.policy ul{padding-left:1.25rem}
.policy table{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.95rem;display:block;overflow-x:auto}
.policy th,.policy td{border:1px solid rgba(128,128,128,.35);padding:.5rem .6rem;text-align:left;vertical-align:top}
.policy th{font-weight:600}
.policy a{text-decoration:underline}
.policy strong{font-weight:600}
</style>
